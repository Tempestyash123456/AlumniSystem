{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://backend-production-feca5.up.railway.app/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://backend-production-feca5.up.railway.app/uploads/:path*"
        },
        {
            "source": "/((?!api|uploads).*)",
            "destination": "/index.html"
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite"
}